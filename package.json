{
  "name": "luna-workspace",
  "private": false,
  "license": "MIT",
  "author": "L.U.N.A. contributors",
  "bin": {
    "luna": "./interfaces/cli/luna.mjs"
  },
  "workspaces": [
    "interfaces/web",
    "interfaces/mobile",
    "docs/site"
  ],
  "scripts": {
    "luna": "node ./interfaces/cli/luna.mjs",
    "install:all": "npm install && npm install --prefix interfaces/desktop",
    "start": "npm run web",
    "dev": "npm run web",
    "dev:lan": "npm run web:lan",
    "web": "node ./interfaces/cli/luna.mjs web",
    "web:lan": "node ./interfaces/cli/luna.mjs web:lan",
    "serve:tailscale": "node ./interfaces/cli/luna.mjs serve --tailscale",
    "serve:tailscale:off": "node ./interfaces/cli/luna.mjs serve --tailscale --off",
    "mobile:dev": "concurrently -n api,vite -c green,cyan \"node ./interfaces/cli/luna.mjs backend\" \"npm run dev --workspace=interfaces/web -- --host 0.0.0.0\"",
    "tunnel": "npx --yes cloudflared tunnel --url http://localhost:5173",
    "tunnel:lt": "npx --yes localtunnel --port 5173",
    "build": "npm run build --workspace=interfaces/web",
    "build:mobile": "npm run build --workspace=interfaces/mobile",
    "build:desktop": "npm run build && npm --prefix interfaces/desktop run build:win",
    "vercel-build": "npm --prefix docs/site run build",
    "assets:logo": "node scripts/build-logo-assets.mjs",
    "docs": "npm --prefix docs/site run dev",
    "docs:build": "npm --prefix docs/site run build",
    "docs:start": "npm --prefix docs/site run start",
    "setup": "node interfaces/cli/luna.mjs setup",
    "docker": "node scripts/docker.mjs",
    "docker:down": "node scripts/docker.mjs --down",
    "docker:logs": "node scripts/docker.mjs --logs",
    "docker:gpu": "node scripts/docker.mjs --gpu",
    "docker:cloud": "node scripts/docker.mjs --cloud",
    "docker:pull": "node scripts/docker.mjs --pull",
    "chat": "node interfaces/cli/luna.mjs chat",
    "health": "node interfaces/cli/luna.mjs health",
    "memory:view": "python scripts/memory_viewer.py",
    "test:tools": "python -W ignore -m unittest discover -s tests/tools -p \"test_*.py\" -v",
    "test:smoke": "npm run luna -- check && node --check interfaces/cli/luna.mjs && npm run test:tools",
    "postinstall": "node scripts/ensure-global-path.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@types/react-grid-layout": "^1.3.6",
    "react-grid-layout": "^2.2.3"
  }
}
