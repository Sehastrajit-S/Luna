# Dependencies
node_modules/
frontend/node_modules/
desktop-app/node_modules/
docs-site/node_modules/

# Build artifacts (rebuilt inside Docker)
frontend/dist/
docs-site/.next/
docs-site/out/

# Runtime data (mounted as a named volume)
data/

# Secrets — never bake into the image
.env

# Git / editor
.git/
.gitignore
.vscode/

# Desktop shell: only its renderer + resources are served as the web UI
desktop-app/node_modules/
desktop-app/build/
desktop-app/src/main/
desktop-app/src/preload/
dist-electron/

# Mobile React app (built locally for Capacitor, not served by Docker)
frontend/

# Docs site (not served by the backend)
docs-site/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/
*.egg-info/

# Logs
*.log

# OS
.DS_Store
Thumbs.db
