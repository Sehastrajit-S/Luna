# Dependencies
node_modules/
interfaces/web/node_modules/
interfaces/desktop/node_modules/
docs/site/node_modules/

# Build artifacts (rebuilt inside Docker)
interfaces/web/dist/
docs/site/.next/
docs/site/out/

# Runtime data (mounted as a named volume)
data/

# Secrets: never bake into the image
.env
.env.*
!.env.example

# Git / editor
.git/
.gitignore
.vscode/

# Desktop shell: only its renderer + resources are served as the web UI
interfaces/desktop/node_modules/
interfaces/desktop/build/
interfaces/desktop/src/main/
interfaces/desktop/src/preload/
dist/

# Mobile React app (built locally for Capacitor, not served by Docker)
interfaces/web/

# Docs site (not served by the backend)
docs/site/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/
*.egg-info/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Local tooling and scratch
.venv/
.tmp/
.claude/
.pip-cache/

# Native mobile projects (built separately)
interfaces/mobile/
